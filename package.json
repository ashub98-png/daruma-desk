{
  "name": "daruma-desk",
  "productName": "Daruma Desk",
  "version": "1.0.0",
  "description": "A to-do reminder that lives on your desktop as daruma dolls",
  "author": "Himanshu Bhardwaj",
  "license": "UNLICENSED",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "start": "npm run helper && electron .",
    "dist": "npm run helper && electron-builder --mac",
    "helper": "swiftc -O -target arm64-apple-macos13 app/helper.swift -o build/helper-arm64 && swiftc -O -target x86_64-apple-macos13 app/helper.swift -o build/helper-x64 && lipo -create build/helper-arm64 build/helper-x64 -output build/helper"
  },
  "build": {
    "appId": "io.github.ashub98-png.daruma-desk",
    "productName": "Daruma Desk",
    "files": [
      "index.html",
      "app/**",
      "vendor/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0",
      "x64ArchFiles": "Contents/Resources/helper"
    },
    "dmg": {
      "title": "Daruma Desk"
    },
    "extraResources": [
      {
        "from": "build/helper",
        "to": "helper"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
